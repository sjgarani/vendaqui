# =============================================================
# VendAqui – Variáveis de Ambiente
# =============================================================
# Copie este arquivo para .env e preencha os valores locais.
#   cp .env.example .env
#
# IMPORTANTE: NUNCA commite o arquivo .env. Ele está no .gitignore.
# Em produção/CI, configure estas variáveis como secrets no
# ambiente de execução (GitHub Actions Secrets, Fly.io secrets, etc).
# =============================================================

# --- Banco de Dados ---
DB_USERNAME=postgres
DB_PASSWORD=           # preencha com sua senha local
DB_HOSTNAME=localhost
DB_NAME=vendaqui_dev

# --- Phoenix ---
# Gere uma nova chave com: mix phx.gen.secret
SECRET_KEY_BASE=       # preencha com o valor gerado por mix phx.gen.secret

# --- Mailer (produção) ---
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
